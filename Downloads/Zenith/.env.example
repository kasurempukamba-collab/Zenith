# ============================================================
# Salin file ini menjadi ".env" lalu sesuaikan isinya.
# JANGAN commit file ".env" ke git / bagikan ke orang lain.
# ============================================================

# Nama bot (muncul di banner & di daftar "Linked Devices" WhatsApp kamu)
BOT_NAME=Zenith

# Awalan perintah, contoh: .menu .ping .sticker
PREFIX=.

# Nomor owner (bisa lebih dari satu, pisahkan dengan koma), format internasional tanpa "+"
# Contoh: 6281234567890,6289876543210
OWNER_NUMBERS=

# Folder untuk menyimpan sesi login (jangan dihapus kalau tidak ingin scan ulang)
SESSION_DIR=session

# true  = login pakai kode pairing 8 digit (ketik di HP, tidak perlu scan QR)
# false = login pakai QR code seperti biasa
USE_PAIRING_CODE=true

# (opsional) isi nomor kamu di sini supaya tidak ditanya setiap start.
# Format internasional tanpa "+", contoh: 6281234567890
PAIRING_NUMBER=

# true = bot HANYA membalas pesan dari OWNER_NUMBERS (paling aman & privat).
# Cocok dipakai di awal sebelum kamu yakin semua berjalan baik.
SELF_MODE=false

# ------------------ Pengaturan anti-ban ------------------
# Nyalakan WARMUP_MODE=true kalau nomor yang dipakai MASIH BARU.
# Kalau nomor sudah lama & biasa dipakai chat normal, boleh diset false.
WARMUP_MODE=true
WARMUP_DAYS=3

MIN_DELAY_MS=1200
MAX_DELAY_MS=3500
WARMUP_MIN_DELAY_MS=4000
WARMUP_MAX_DELAY_MS=9000

# Batas "kontak baru" per hari = nomor yang bot hubungi DULUAN. Membalas orang yang chat lebih
# dulu TIDAK dihitung. Kalau batas tercapai, pesan ke kontak baru berikutnya DIBLOKIR (bukan
# sekadar peringatan) sampai pergantian hari (UTC). 0 = bot tidak boleh memulai chat dengan siapa pun.
NEW_CONTACT_DAILY_CAP=20
WARMUP_NEW_CONTACT_DAILY_CAP=5

# Maksimal waktu (ms) menunggu satu pengiriman pesan selesai sebelum antrean dilepas.
SEND_TIMEOUT_MS=120000

SIMULATE_TYPING=true

# ------------------ Fitur AI chat (opsional) ------------------
# Isi kalau mau fitur ".ai <pertanyaan>" aktif. Kosongkan untuk menonaktifkan.
# Dapatkan API key di https://console.anthropic.com/
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
# Maksimal waktu (ms) menunggu jawaban AI. Naikkan kalau kamu memakai model besar yang lebih lambat.
AI_TIMEOUT_MS=45000

# ------------------ Perintah .tagall ------------------
# Mention dikirim bertahap: TAGALL_CHUNK_SIZE mention per pesan. Grup dengan anggota lebih dari
# TAGALL_MAX_MEMBERS ditolak (mencegah banjir pesan mention di grup yang sangat besar).
TAGALL_CHUNK_SIZE=50
TAGALL_MAX_MEMBERS=256

# ------------------ Penyimpanan pesan terkirim ------------------
# Bot menyimpan pesan terkirim terakhir ke data/messages.json supaya bisa mengirim ulang pesan yang
# gagal didekripsi penerima, bahkan setelah bot restart. Aman dihapus kapan saja.
MESSAGE_STORE_MAX_ENTRIES=1000
MESSAGE_STORE_TTL_HOURS=48

# ------------------ Lain-lain ------------------
# silent | info | debug  (debug = sangat detail, untuk troubleshooting)
LOG_LEVEL=silent
